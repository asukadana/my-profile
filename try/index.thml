<!DOCTYPE html>
<html lang="jp">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100">
    <h2 class="flex font-bold text-lg items-center justify-center p-3">TODoリスト</h2>

    <div class="flex gap-3">
        <input type="text" id="toDo" placeholder="タスクを入力してください" class="bg-white shadow rounded">
        <button id="button" class="bg-white shadow rounded">追加</button>
    </div>
        <ul id="taskList"></ul>


<script>
const toDo = document.querySelector("#toDo");
const button = document.querySelector("#button");
const taskList = document.querySelector("#taskList");

button.addEventListener("click", () => {
    const task = toDo.value;

    // 空欄なら追加しない
    if (task === "") {
        return;
    }

    // liを作る
    const item = document.createElement("li");
    item.className = "flex items-center justify-between bg-gray-50 rounded px-3 py-2";

    // タスクの文字を入れるspanを作る
    const span = document.createElement("span");
    span.textContent = task;

    // 完了ボタンを作る
    const doneBtn = document.createElement("button");
    doneBtn.textContent = "完了";
    doneBtn.className = "text-sm text-gray-500 hover:text-red-500";

    // 完了ボタンを押したとき
    doneBtn.addEventListener("click", () => {
        span.classList.toggle("line-through");
        span.classList.toggle("text-gray-400");
    });

    // 削除ボタンを作る
    const deleteBtn = document.createElement("button");
    deleteBtn.textContent = "削除";
    deleteBtn.className = "text-sm text-red-500";

    // 削除ボタンを押したとき
    deleteBtn.addEventListener("click", () => {
        item.remove();
    });

    // liの中にspan、完了ボタン、削除ボタンを入れる
    item.appendChild(span);
    item.appendChild(doneBtn);
    item.appendChild(deleteBtn);

    // ulの中にliを追加
    taskList.appendChild(item);

    // 入力欄を空にする
    toDo.value = "";
});


</script>
    
</body>
</html>